{
  "name": "marketplace-profit-analytics",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "supabase:session-url": "powershell -ExecutionPolicy Bypass -File scripts/set-supabase-direct-url.ps1",
    "supabase:direct-url": "powershell -ExecutionPolicy Bypass -File scripts/set-supabase-direct-url.ps1",
    "supabase:fix-rls-advisor": "node scripts/enable-prisma-migrations-rls.mjs",
    "supabase:apply-import-migration": "node scripts/apply-import-framework-migration-pooled.mjs",
    "supabase:apply-refund-migration": "node scripts/apply-refund-migration-pooled.mjs",
    "supabase:apply-po-sales-fields-migration": "node scripts/apply-po-sales-fields-migration-pooled.mjs",
    "supabase:apply-po-import-optimization-migration": "node scripts/apply-po-import-optimization-migration-pooled.mjs",
    "supabase:apply-po-quantity-audit-migration": "node scripts/apply-po-quantity-audit-migration-pooled.mjs",
    "supabase:apply-settlement-payout-migration": "node scripts/apply-settlement-payout-migration-pooled.mjs",
    "seed:validation": "node scripts/seed-validation-data.mjs",
    "cleanup:walmart-sales": "node scripts/cleanup-walmart-sales-imports.mjs",
    "cleanup:manual-imports": "node scripts/cleanup-manual-import-data.mjs",
    "cleanup:walmart-reporting": "node scripts/audit-walmart-reporting-reset.mjs",
    "repair:walmart-sales-imports": "node scripts/repair-walmart-sales-import-status.mjs",
    "repair:settlement-fee-attribution": "node scripts/repair-settlement-fee-attribution.mjs",
    "diagnose:po-quantity": "node scripts/diagnose-po-quantity.mjs",
    "diagnose:unallocated-settlement-fees": "node scripts/diagnose-unallocated-settlement-fees.mjs",
    "audit:virtual-pack-parent-grouping": "node scripts/audit-virtual-pack-parent-grouping.mjs",
    "catalog:map-sku-parent": "node scripts/map-sku-parent.mjs",
    "validate:product-pnl": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/validate-product-vs-marketplace-pnl.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@tanstack/react-table": "8.20.5",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2"
  }
}
