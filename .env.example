# Local PostgreSQL app connection.
DATABASE_URL="postgresql://marketplace:marketplace@localhost:5432/marketplace_pnl?schema=public"

# Direct PostgreSQL connection for Prisma migrations.
# For local Docker Postgres this can match DATABASE_URL.
# For Supabase, use the direct database URL here and keep DATABASE_URL pointed at the pooler.
DIRECT_URL="postgresql://marketplace:marketplace@localhost:5432/marketplace_pnl?schema=public"
