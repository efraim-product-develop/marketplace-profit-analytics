# App/runtime PostgreSQL connection.
# Local development can use local Postgres.
# Supabase should use the normal pooled app connection here.
DATABASE_URL="postgresql://marketplace:marketplace@localhost:5432/marketplace_pnl?schema=public"

# Prisma migration/CLI PostgreSQL connection.
# Local development can match DATABASE_URL.
# Supabase local Windows development should use the Supavisor Session pooler here,
# because the direct db.PROJECT_REF.supabase.co host may be unreachable.
# General Supabase format:
# postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL="postgresql://marketplace:marketplace@localhost:5432/marketplace_pnl?schema=public"

# Walmart Marketplace API credentials.
# Keep real values in .env only; do not commit them.
WALMART_MARKETPLACE_CLIENT_ID=""
WALMART_MARKETPLACE_CLIENT_SECRET=""
WALMART_MARKET="us"
WALMART_SERVICE_NAME="Walmart Marketplace"
WALMART_API_BASE_URL="https://marketplace.walmartapis.com"

# Optional, but useful if Walmart provides these values in your developer setup.
WALMART_CONSUMER_CHANNEL_TYPE=""
WALMART_SELLER_ID=""
